generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  IDEA
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  ARCHIVED
}

enum EvidenceType {
  COMMIT
  PULL_REQUEST
  TEST
  ADR
  DIAGRAM
  SCREENSHOT
  RELEASE
  DEPLOY
  BENCHMARK
  OTHER
}

enum DecisionStatus {
  PROPOSED
  ACCEPTED
  SUPERSEDED
  REJECTED
}

model Project {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  repository  String?
  demoUrl     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  skillLinks ProjectSkill[]
  evidences  Evidence[]
  decisions  ArchitectureDecision[]

  @@index([status])
}

model Skill {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectLinks ProjectSkill[]
  evidences   Evidence[]
}

model ProjectSkill {
  projectId String
  skillId   String
  context   String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
}

model Evidence {
  id          String       @id @default(cuid())
  title       String
  description String?
  type        EvidenceType
  url         String?
  projectId   String
  skillId     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill?  @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([projectId, type])
  @@index([skillId])
}

model ArchitectureDecision {
  id          String         @id @default(cuid())
  code        String         @unique
  title       String
  context     String
  decision    String
  consequences String?
  status      DecisionStatus @default(PROPOSED)
  projectId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}
